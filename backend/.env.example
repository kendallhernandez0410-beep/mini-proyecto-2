# ==============================================================================
# CONFIGURACIÓN DEL BACKEND (MVC + MULTIAGENTE)
# Empresa: Tecnologías Pura Vida S.A. (San José, Costa Rica)
# ==============================================================================

PORT=4000
NODE_ENV=development

# 1. Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=portal_rrhh

# 2. Seguridad y JWT
JWT_SECRET=tu_jwt_secret_super_seguro
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# 3. Google Gemini API (gemini-flash-lite-latest + text-embedding)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_LLM_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_SIMILARITY_THRESHOLD=0.55

# 4. Google Drive API (Service Account de Solo Lectura)
GOOGLE_DRIVE_FOLDER_ID=tu_google_drive_folder_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu_cuenta_de_servicio@proyecto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_private_key_aqui\n-----END PRIVATE KEY-----\n"

# 5. Cron Job del Reporte Diario (7:00 a.m. Costa Rica)
REPORT_CRON_SCHEDULE="0 7 * * *"
REPORT_CRON_TIMEZONE="America/Costa_Rica"
